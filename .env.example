HOST=127.0.0.1
PORT=3001
# Public EVE SSO OAuth callback URL, served by the main HTTP server on this
# port. Set it for container/ingress deployments (k3s/Traefik) and make it
# match the callback URL registered with the EVE SSO app, e.g.
# EVE_SSO_CALLBACK_URL=https://galaxy.example.net/callback
# When unset, esi_login uses the local default http://localhost:8085/callback.
